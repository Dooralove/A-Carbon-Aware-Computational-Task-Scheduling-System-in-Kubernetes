# Docker build context is the repository root.
# Keep the context small: only Go sources, module files, and replay datasets.

.git
.gitignore
.gitattributes
.cursor
.idea
.vscode

# Local toolchains and build outputs
.tools
bin
dist
*.exe
*.out
coverage.out
coverage.html

# Docs, analysis, tests, and cluster manifests are not compiled into images
docs
analysis
tests
deployments
experiments/results
experiments/workloads
experiments/scenarios
experiments/datasets/schemas
experiments/datasets/_generate_and_validate.py

# Secrets and local env (DOD-CODE-07 / CFG-04)
.env
.env.*
**/*.pem
**/*.key
secrets
credentials.json
