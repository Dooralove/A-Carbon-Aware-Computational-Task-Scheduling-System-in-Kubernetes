{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbon-aware.io/schemas/replay_dataset.schema.json",
  "title": "ReplayDataset",
  "description": "Versioned historical or synthetic carbon-intensity slice for HistoricalDatasetProvider. Replay Engine advances model time, not wall-clock (REPRO-03). File name: <source>_<zone>_<period>_v<N>.json (VER-20).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "source",
    "scenario",
    "unit",
    "emissionFactorType",
    "temporalGranularity",
    "intervalSeconds",
    "modelStart",
    "modelEnd",
    "zones",
    "series",
    "forecastMode"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*_v[0-9]+$",
      "description": "Stable identifier, equals file stem without extension."
    },
    "source": {
      "type": "string",
      "enum": ["electricity-maps", "neso", "synthetic", "mock"]
    },
    "scenario": {
      "type": "string",
      "enum": ["stable", "dynamic", "volatile"],
      "description": "Typology of CI(t) behaviour for experimental isolation."
    },
    "description": { "type": "string" },
    "unit": {
      "type": "string",
      "const": "gCO2e/kWh"
    },
    "emissionFactorType": {
      "type": "string",
      "enum": ["lifecycle", "direct"]
    },
    "flowTraced": { "type": "boolean" },
    "temporalGranularity": {
      "type": "string",
      "enum": ["5_minutes", "15_minutes", "30_minutes", "60_minutes"]
    },
    "intervalSeconds": {
      "type": "integer",
      "enum": [300, 900, 1800, 3600]
    },
    "timeBase": {
      "type": "string",
      "const": "model",
      "description": "Replay clock is model time. Wall-clock is ignored (REPRO-03)."
    },
    "modelStart": {
      "type": "string",
      "format": "date-time",
      "description": "Inclusive start of the replay window (UTC)."
    },
    "modelEnd": {
      "type": "string",
      "format": "date-time",
      "description": "Exclusive end of the replay window (UTC)."
    },
    "seed": {
      "type": "integer",
      "description": "PRNG seed used to generate synthetic series. Required for source=synthetic."
    },
    "forecastMode": {
      "type": "string",
      "enum": ["none", "persistence", "recorded"],
      "description": "none: empty ForecastArray, plugin uses CI_current. persistence: ForecastArray filled with CI(t). recorded: use forecastSnapshots. Perfect-foresight (future actuals) is forbidden as the default experimental forecast."
    },
    "forecastHorizonSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 259200
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone"],
        "properties": {
          "zone": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$"
          },
          "sourceZone": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "variability": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declared statistics used as acceptance gates for the scenario class. Computed on the stored series, per zone, then summarised.",
      "properties": {
        "coefficientOfVariationMax": { "type": "number", "minimum": 0 },
        "coefficientOfVariationMin": { "type": "number", "minimum": 0 },
        "maxStepGco2ePerKwh": { "type": "number", "minimum": 0 },
        "rankingReversals": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of times the zone with minimum CI changes during the window."
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "description": "Observations. Unique (zone, timestamp). Sorted by timestamp, then zone. Piecewise-constant on [timestamp, timestamp+intervalSeconds).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone", "timestamp", "carbonIntensity"],
        "properties": {
          "zone": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$"
          },
          "timestamp": { "type": "string", "format": "date-time" },
          "carbonIntensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 2000
          },
          "carbonFreePercentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "isEstimated": { "type": "boolean" }
        }
      }
    },
    "forecastSnapshots": {
      "type": "array",
      "description": "Optional recorded forecasts. Present iff forecastMode=recorded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone", "issuedAt", "forecast"],
        "properties": {
          "zone": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$"
          },
          "issuedAt": { "type": "string", "format": "date-time" },
          "forecast": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["timestamp", "carbonIntensity"],
              "properties": {
                "timestamp": { "type": "string", "format": "date-time" },
                "carbonIntensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2000
                },
                "horizonSeconds": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
