# syntax=docker/dockerfile:1.7
# carbon-aware-scheduler: kube-scheduler + CarbonAware plugin (CFG-04).
# Build from the repository root:
#   docker build -f build/Dockerfile.scheduler -t carbon-aware-scheduler:0.1.0 .

ARG GO_IMAGE=golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd
# debian12 pin of gcr.io/distroless/static:nonroot (unsuffixed tag is deprecated).
ARG DISTROLESS_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

FROM ${GO_IMAGE} AS builder
WORKDIR /src

ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY api ./api
COPY pkg ./pkg
COPY cmd/scheduler ./cmd/scheduler

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w -buildid=" -o /out/kube-scheduler ./cmd/scheduler

FROM ${DISTROLESS_IMAGE}

COPY --from=builder --chown=65532:65532 /out/kube-scheduler /usr/local/bin/kube-scheduler

USER 65532:65532
WORKDIR /home/nonroot

ENTRYPOINT ["/usr/local/bin/kube-scheduler"]
