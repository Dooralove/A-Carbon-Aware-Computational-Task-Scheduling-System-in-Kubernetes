# syntax=docker/dockerfile:1.7
# carbon-workload-runner: synthetic CPU-bound batch task of the Stage 10
# experiments (T10.1, experiments/workloads/synthetic_task.go).
# Build from project/:
#   docker build -f build/Dockerfile.workload -t carbon-workload-runner:0.1.0 .

ARG GO_IMAGE=golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd
# debian12 pin of gcr.io/distroless/static:nonroot (unsuffixed tag is deprecated).
ARG DISTROLESS_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

FROM ${GO_IMAGE} AS builder
WORKDIR /src

ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64

# The task uses only the standard library, so no module download is needed.
COPY go.mod ./
COPY experiments/workloads/synthetic_task.go ./experiments/workloads/

RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w -buildid=" -o /out/synthetic-task ./experiments/workloads

FROM ${DISTROLESS_IMAGE}

COPY --from=builder --chown=65532:65532 /out/synthetic-task /usr/local/bin/synthetic-task

USER 65532:65532
WORKDIR /home/nonroot

ENTRYPOINT ["/usr/local/bin/synthetic-task"]
